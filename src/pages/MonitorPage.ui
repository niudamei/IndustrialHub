     <layout class="QVBoxLayout" name="demoLayout">
      <item>
       <widget class="QLabel" name="demoDescriptionLabel">
        <property name="text"><string>无需连接真实硬件。启动后会创建 3 台仅存在于监控页面的虚拟设备，持续生成 TX/RX 数据，供事件记录、设备统计和实时趋势页面测试。模拟数据不会发送到真实设备，也不会写入设备数据库。</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="demoDeviceLayout">
        <item><widget class="QLabel" name="demoCanLabel"><property name="text"><string>CAN 采集盒 1  |  DEMO-CAN-001</string></property></widget></item>
        <item><widget class="QLabel" name="demoCanFdLabel"><property name="text"><string>CAN-FD 采集盒 2  |  DEMO-CANFD-002</string></property></widget></item>
        <item><widget class="QLabel" name="demoTcpLabel"><property name="text"><string>导航控制器  |  DEMO-TCP-003</string></property></widget></item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="demoControlLayout">
        <item><widget class="QLabel" name="demoIntervalLabel"><property name="text"><string>模拟周期：</string></property></widget></item>
